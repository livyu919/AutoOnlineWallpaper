<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>自动壁纸轮换</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.user.autoonlinewallpaper</string>
			<key>key</key>
			<string>enableAuto</string>
			<key>label</key>
			<string>开启自动轮换</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.user.autoonlinewallpaper</string>
			<key>key</key>
			<string>useOnlineMode</string>
			<key>label</key>
			<string>在线网络图片模式(关闭则本地文件夹)</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTextFieldCell</string>
			<key>defaults</key>
			<string>com.user.autoonlinewallpaper</string>
			<key>key</key>
			<string>onlineImgURL</string>
			<key>label</key>
			<string>在线图片链接</string>
			<key>placeholder</key>
			<string>https://xxx.jpg</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTextFieldCell</string>
			<key>defaults</key>
			<string>com.user.autoonlinewallpaper</string>
			<key>key</key>
			<string>intervalTime</string>
			<key>label</key>
			<string>轮换间隔(秒)</string>
			<key>placeholder</key>
			<string>300</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>立即更换壁纸</string>
			<key>action</key>
			<string>manualChangeTap</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>使用说明</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStaticTextCell</string>
			<key>text</key>
			<string>在线模式：填入直链图片地址；本地模式：图片放到 /var/jb/Library/Application Support/AutoOnlineWallpaper/</string>
		</dict>
	</array>
</dict>
</plist>
